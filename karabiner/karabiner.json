{
  "global": {
    "check_for_updates_on_startup": false,
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "complex_modifications": {
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 200,
          "basic.to_if_held_down_threshold_milliseconds": 200
        },
        "rules": [
          {
            "description": "Remap Caps Lock to Hyper key when held, Esc when tapped",
            "manipulators": [
              {
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_shift",
                    "lazy": true
                  },
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 0
                    }
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Remap Tab to Ctrl when held, Tab when tapped",
            "manipulators": [
              {
                "from": {
                  "key_code": "tab"
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": [
                      "any"
                    ]
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "tab"
                  }
                ],
                "type": "basic"
              }
            ]
          },
